#!/bin/bash

# --- EAGLE-EYE BANNER ---
echo "███████╗ █████╗  ██████╗ ██╗     ███████╗    ███████╗██╗   ██╗███████╗"
echo "██╔════╝██╔══██╗██╔════╝ ██║     ██╔════╝    ██╔════╝██║   ██║██╔════╝"
echo "█████╗  ███████║██║  ███╗██║     █████╗      █████╗  ██║   ██║█████╗  "
echo "██╔══╝  ██╔══██║██║   ██║██║     ██╔══╝      ██╔══╝  ╚██╗ ██╔╝██╔══╝  "
echo "███████╗██║  ██║╚██████╔╝███████╗███████╗    ███████╗ ╚████╔╝ ███████╗"
echo "                         [ Created in Void Labs by knull ]"
echo "-------------------------------------------------------------------------"

# 1. Interactive Target Prompt (Requires root domain like yamaha-motor.com)
echo -n "Enter root target domain (e.g., yamaha-motor.com) > "
read DOMAIN

if [ -z "$DOMAIN" ]; then
    echo "[-] Error: No domain provided. Exiting."
    exit 1
fi

# 2. Scan Mode Selection Menu
echo ""
echo "Select your scan intensity:"
echo "  [1] Normal Scan (Standard Web Ports: 80, 443, 8080, 8443, 3000)"
echo "  [2] 1000 Port Scan (Top 1000 common ports)"
echo "  [3] Ultra Scan (Full Port Scan - All 65,535 ports)"
echo -n "Select option [1-3] > "
read MODE

# Function for the 15-second loading bar warning
run_warning_countdown() {
    local scan_type=$1
    echo "=================================================="
    echo " [!] WARNING: HEAVY PORT SCAN INTRODUCED [!]"
    echo " This version will scan $scan_type."
    echo " Press CTRL+C within 15 seconds to abort."
    echo "=================================================="
    echo "This may trigger client's Intrusion Detection System (IDS), blow up their rate limits, or crash a fragile server."
    
    total_time=15
    for ((i=total_time; i>=1; i--)); do
        completed=$((total_time - i + 1))
        bar=""
        for ((j=1; j<=total_time; j++)); do
            if [ $j -le $completed ]; then
                bar="${bar}#"
            else
                bar="${bar}."
            fi
        done
        printf "\r[+] Starting in [%s] %2d seconds remaining..." "$bar" "$i"
        sleep 1
    done
    echo -e "\n"
}

# 3. Handle Menu Selection Logic
case $MODE in
    1)
        echo "[+] Mode 1 selected: Normal Web Scan (No delay)."
        NMAP_PORTS="80,443,8080,8443,3000"
        ;;
    2)
        run_warning_countdown "1,000 ports per host"
        NMAP_PORTS="1-1000"
        ;;
    3)
        run_warning_countdown "65,535 ports per host (Full Scan)"
        NMAP_PORTS="-"
        ;;
    *)
        echo "[-] Invalid selection. Defaulting to Normal Web Scan (Mode 1)."
        NMAP_PORTS="80,443,8080,8443,3000"
        ;;
esac

# Setup output directory
OUTPUT_DIR="recon_$DOMAIN"
mkdir -p "$OUTPUT_DIR"

echo ""
echo "[+] Target set to: $DOMAIN"
echo "[+] Results will be saved in: $OUTPUT_DIR/"

# --- Phase 1: Passive Subdomain Discovery ---
echo "[*] Phase 1: Running subfinder for passive subdomain discovery..."
subfinder -d "$DOMAIN" -silent -o "$OUTPUT_DIR/subdomains_passive.txt"
echo "[+] Found $(wc -l < "$OUTPUT_DIR/subdomains_passive.txt") subdomains."

# --- Phase 2: DNS Resolution ---
echo "[*] Phase 2: Resolving active subdomains..."
cat "$OUTPUT_DIR/subdomains_passive.txt" | dnsx -silent -a -resp-only > "$OUTPUT_DIR/hosts_for_nmap.txt"
cat "$OUTPUT_DIR/subdomains_passive.txt" | dnsx -silent > "$OUTPUT_DIR/subdomains_resolved.txt"
echo "[+] Active host and IP resolution complete."

# --- Phase 3: HTTP Probing & Clean Pipeline Generation ---
echo "[*] Phase 3: Probing live web servers with httpx..."

# 1. Human-readable audit log (with status codes, tech stack, and metadata)
cat "$OUTPUT_DIR/subdomains_passive.txt" | httpx -silent -status-code -tech-detect -o "$OUTPUT_DIR/live_web_assets.txt"

# 2. Machine-readable clean domain list (FOR PROJECT 2 / DEEP_HARVEST INPUT)
cat "$OUTPUT_DIR/subdomains_passive.txt" | httpx -silent > "$OUTPUT_DIR/live_domains_for_harvest.txt"
echo "[+] Clean live domain list generated: $OUTPUT_DIR/live_domains_for_harvest.txt"

# --- Phase 4: Executing Nmap Port Scanning Based on User Selection ---
if [ -s "$OUTPUT_DIR/hosts_for_nmap.txt" ]; then
    echo "[*] Running Nmap port scan using selected profile..."
    nmap --privileged -iL "$OUTPUT_DIR/hosts_for_nmap.txt" -p "$NMAP_PORTS" -T4 --open -oN "$OUTPUT_DIR/nmap_scan_results.txt"
    echo "[+] Nmap scan complete. Results saved to $OUTPUT_DIR/nmap_scan_results.txt"
else
    echo "[-] No hosts found for Nmap scanning."
fi

echo "[+] Eagle-Eye perimeter discovery complete! All files ready in '$OUTPUT_DIR/'"
